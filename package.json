{
  "name": "model-view",
  "private": true,
  "version": "0.1.0",
  "description": "Canonical React/local weather model-view prototype with NOAA GRIB2 artifacts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests-node/*.test.js && npm run typecheck && eslint . --quiet && npm run format:check && npm run smoke:react",
    "dev": "node scripts/local-dev.js",
    "dev:vite": "vite",
    "basemap:fetch": "node scripts/prepare-basemap.js",
    "local:build": "node scripts/build-noaa-beta-artifacts.js",
    "local:data": "node scripts/local-data-server.js",
    "local:dev": "node scripts/local-dev.js",
    "local:clear-cache": "node scripts/clear-render-cache.js",
    "cache:clear": "node scripts/clear-render-cache.js",
    "cache:prune": "node scripts/prune-render-cache.js",
    "noaa:build": "node scripts/build-noaa-beta-artifacts.js",
    "noaa:build:full": "node scripts/build-noaa-beta-recent-runs.js",
    "noaa:update": "node scripts/noaa-update.js",
    "noaa:build:test": "node scripts/build-noaa-beta-test-render.js",
    "parcel-kernel:build": "asc tools/parcel-kernel/assembly/index.ts --outFile tools/parcel-kernel/build/parcel-kernel.wasm -O3 --runtime stub --noAssert --enable simd",
    "noaa:prefetch-soundings": "node scripts/prefetch-point-soundings.js",
    "noaa:snow-rf:export": "node scripts/export-snow-rf-model.js",
    "noaa:data": "node scripts/local-data-server.js",
    "noaa:dev": "node scripts/local-dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/local-start.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "maintainability:report": "node scripts/maintainability-report.js",
    "smoke": "npm run smoke:react",
    "smoke:react": "playwright test -c playwright.react.config.js --reporter=line",
    "smoke:react:headed": "playwright test -c playwright.react.config.js --workers=1 --reporter=line --headed",
    "test:react": "playwright test -c playwright.react.config.js --reporter=line",
    "test:local-runtime": "node --test tests-node/noaa-beta.test.js tests-node/frame-worker-pool.test.js",
    "test:local-integration": "node tests-node/local-integration.js",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "libdeflate": "^0.1.0",
    "maplibre-gl": "5.24.0",
    "pmtiles": "^4.4.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "assemblyscript": "^0.28.19",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.1"
  }
}
