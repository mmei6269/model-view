# NOAA artifact runtime
MODELVIEW_DATA_HOST=127.0.0.1
MODELVIEW_DATA_PORT=5174
MODELVIEW_CACHE_ROOT=output/noaa-beta-cache
MODELVIEW_ARTIFACT_PREFIX=tiles
MODELVIEW_ARTIFACT_BASE_URL=http://127.0.0.1:5174
MODELVIEW_REFLECTIVITY_GATES=15,20

# Optional browser override
VITE_ARTIFACT_BASE_URL=

# Tooling
# Absolute path to wgrib2. When unset, builds fall back to
# output/noaa-beta-tools/bin/wgrib2 if present, then wgrib2 on PATH.
WGRIB2=
# PNG deflate backend: libdeflate (default) or zlib to force the node zlib path.
MODELVIEW_PNG_DEFLATE_BACKEND=

# Cache retention
# Optional total cache ceiling in GB. noaa:update and cache:prune delete the
# oldest prunable runs past this; the newest run per model is never deleted.
MODELVIEW_CACHE_BUDGET_GB=
# DEPRECATED alias of MODELVIEW_CACHE_ROOT (logs a warning when used).
MODELVIEW_NOAA_BETA_CACHE_ROOT=

# Build concurrency / behavior knobs (read by scripts/build-noaa-beta-artifacts.js)
# Default model list when --models is not passed (e.g. gfs,nam,nam3km,hrrr).
MODELVIEW_NOAA_BETA_MODELS=
# Default forecast hours when --hours is not passed (e.g. 0,3,6).
MODELVIEW_NOAA_BETA_HOURS=
# Frames rendered concurrently per model build.
MODELVIEW_NOAA_FRAME_CONCURRENCY=
# Render worker processes per build.
MODELVIEW_NOAA_WORKER_COUNT=
# Set to 1 to enable per-frame render profiling output.
MODELVIEW_NOAA_PROFILE=
