# NOAA artifact runtime
MODELVIEW_DATA_HOST=127.0.0.1
MODELVIEW_DATA_PORT=5174
MODELVIEW_CACHE_ROOT=output/noaa-beta-cache
MODELVIEW_ARTIFACT_PREFIX=tiles
MODELVIEW_ARTIFACT_BASE_URL=http://127.0.0.1:5174
MODELVIEW_REFLECTIVITY_GATES=15,20

# Optional browser override
VITE_ARTIFACT_BASE_URL=

# Tooling
# Absolute path to wgrib2. When unset, builds fall back to
# output/noaa-beta-tools/bin/wgrib2 if present, then wgrib2 on PATH.
WGRIB2=
# PNG deflate backend: libdeflate (default) or zlib to force the node zlib path.
MODELVIEW_PNG_DEFLATE_BACKEND=

# Cache retention
# Optional total cache ceiling in GB. noaa:update and cache:prune delete the
# oldest prunable runs past this; the newest run per model is never deleted.
MODELVIEW_CACHE_BUDGET_GB=
# DEPRECATED alias of MODELVIEW_CACHE_ROOT (logs a warning when used).
MODELVIEW_NOAA_BETA_CACHE_ROOT=

# Build concurrency / behavior knobs (read by scripts/build-noaa-beta-artifacts.js)
# Default model list when --models is not passed (e.g. gfs,nam,nam3km,hrrr).
MODELVIEW_NOAA_BETA_MODELS=
# Default forecast hours when --hours is not passed (e.g. 0,3,6).
MODELVIEW_NOAA_BETA_HOURS=
# Frames rendered concurrently per model build.
MODELVIEW_NOAA_FRAME_CONCURRENCY=
# Render worker processes per build.
MODELVIEW_NOAA_WORKER_COUNT=
# Set to 1 to enable per-frame render profiling output.
MODELVIEW_NOAA_PROFILE=

# Run selection / behavior (builder)
# Render the full published horizon (same as --full).
MODELVIEW_NOAA_FULL_RUN=
# Use the Nth-latest run instead of the latest (0-24).
MODELVIEW_NOAA_RUN_OFFSET=
# Fail instead of capping when a cycle has not published the full horizon.
MODELVIEW_NOAA_REQUIRE_FULL_HORIZON=
# Opt-in GFS hourly-through-F120 source cadence (209-frame tier).
MODELVIEW_NOAA_GFS_HOURLY_THROUGH_120=
# Force re-render frames whose artifacts already exist.
MODELVIEW_NOAA_FORCE_RENDER=
# Override the NOAA base URL (all models; per-model URLs come from config).
MODELVIEW_NOAA_BASE_URL=
# Fail bulk decode instead of falling back to per-record decode.
MODELVIEW_NOAA_STRICT_BULK_DECODE=

# Scheduler / concurrency (builder; blank means default)
MODELVIEW_NOAA_MODEL_CONCURRENCY=
MODELVIEW_NOAA_TOTAL_FRAME_CONCURRENCY=
MODELVIEW_NOAA_GLOBAL_FRAME_QUEUE=
MODELVIEW_NOAA_GLOBAL_FRAME_CONCURRENCY=
MODELVIEW_NOAA_RANGE_CONCURRENCY=
MODELVIEW_NOAA_TOTAL_RANGE_CONCURRENCY=
MODELVIEW_NOAA_DECODE_CONCURRENCY=
MODELVIEW_FRAME_RETRIES=
MODELVIEW_RETRY_DELAY_MS=
MODELVIEW_NOAA_RETRY_FRAME_CONCURRENCY=
# Intra-frame derived parallelism: auto | N | off (see plan.md).
MODELVIEW_NOAA_DERIVED_CELL_CONCURRENCY=
# Background main-GRIB prefetch pump slots: 0-16, 0/off disables.
MODELVIEW_NOAA_INPUT_PREFETCH=
# Compression helper threads per render worker: 0-4, 0 compresses inline.
MODELVIEW_NOAA_COMPRESS_THREADS=

# Persistence knobs (experimental persist queue stays off by default)
MODELVIEW_NOAA_GLOBAL_PERSIST_QUEUE=
MODELVIEW_NOAA_GLOBAL_PERSIST_CONCURRENCY=
MODELVIEW_NOAA_GLOBAL_PERSIST_BACKLOG=
MODELVIEW_NOAA_SNOW_PERSIST_CONCURRENCY=
MODELVIEW_NOAA_SNOW_PERSIST_BACKLOG=
MODELVIEW_ARTIFACT_WRITE_CONCURRENCY=
MODELVIEW_NOAA_PERSIST_MANIFEST_EACH_FRAME=

# Kernel escapes (see plan.md Optimization Notes for the numeric contracts)
# wasm-f32 (default) | wasm | js.
MODELVIEW_PARCEL_KERNEL=
# off keeps the JS derived cell loop while other kernel ports stay active.
MODELVIEW_DERIVED_SLAB=
